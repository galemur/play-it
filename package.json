{
  "name": "play-it",
  "version": "1.0.0",
  "description": "Upload a Japanese voice recording, transcribe it, and play it back with synced text",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "build": "node scripts/build-static.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "express": "^5.3.0",
    "kuromoji": "^0.1.2",
    "mpg123-decoder": "^1.0.3",
    "multer": "^2.4.0",
    "openai": "^7.39.0",
    "wavefile": "^11.0.0"
  }
}
