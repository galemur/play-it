# Which transcriber to use: "local" (offline Whisper, default) or "openai" (cloud API).
TRANSCRIBER=local

# --- Local (offline) options ---
# Any Transformers.js-compatible Whisper model from Hugging Face.
# LOCAL_MODEL=onnx-community/whisper-large-v3-turbo
# Quantization per part: q8 (default, fast) | fp16 | fp32 (most accurate, slowest) | q4
# LOCAL_ENCODER_DTYPE=q8
# LOCAL_DECODER_DTYPE=q8
# Where downloaded models are stored.
# MODEL_CACHE_DIR=~/.cache/play-it/models
# MAX_UPLOAD_MB=200

# --- Cloud options (TRANSCRIBER=openai); any OpenAI-compatible Whisper endpoint ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# TRANSCRIBE_MODEL=whisper-1

# PORT=3000
